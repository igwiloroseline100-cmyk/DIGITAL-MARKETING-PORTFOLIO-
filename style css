/* =====================================================
   ROSELINE IGWILO — DIGITAL MARKETING PORTFOLIO
   Homepage / Category Interface
===================================================== */


/* ---------- RESET ---------- */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #061326;
    color: #ffffff;
    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}

span {
    color: #4b82ff;
}


/* ---------- LAYOUT ---------- */

.hero,
.expertise-section,
.about-section,
.contact-section {
    width: 100%;
}

.hero-content,
.section-intro,
.category-grid,
.about-content,
.contact-section > *,
.footer-container,
.nav-container {
    width: 90%;
    max-width: 1180px;
    margin-left: auto;
    margin-right: auto;
}


/* =====================================================
   NAVIGATION
===================================================== */

.navbar {
    position: sticky;
    top: 0;
    z-index: 1000;

    background: rgba(6, 19, 38, 0.92);
    border-bottom: 1px solid rgba(75, 130, 255, 0.18);

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
}

.nav-container {
    min-height: 78px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

