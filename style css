/* =========================================
   ROSELINE IGWILO — DIGITAL MARKETING
   ROYAL BLUE PROFESSIONAL THEME
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
    background: #f4f7fb;
    color: #0b1f3a;
}

/* =========================
   NAVIGATION
========================= */

header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #061a35;
    border-bottom: 1px solid #173d70;
}

nav {
    max-width: 1150px;
    margin: auto;
    padding: 18px 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

nav h2 {
    font-size: 25px;
    color: #ffffff;
    letter-spacing: 1px;
}

nav div {
    display: flex;
    align-items: center;
    gap: 20px;
}

nav a {
    color: #dce9ff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: 0.2s ease;
}

nav a:hover {
    color: #4d8dff;
}

/* =========================
   GENERAL SECTIONS
========================= */

section {
    max-width: 1150px;
    margin: auto;
    padding: 100px 25px;
}

section h2 {
    font-size: 40px;
    line-height: 1.2;
    margin-bottom: 20px;
    color: #071d3b;
}

section h3 {
    font-size: 22px;
    margin-bottom: 15px;
    color: #0a2f63;
}

section p {
    color: #52657d;
}

/* =========================
   HERO
========================= */

#home {
    max-width: none;
    min-height: 92vh;
    padding: 120px max(25px, calc((100% - 1100px) / 2));
    display: flex;
    flex-direction: column;
    justify-content: center;

    background:
        radial-gradient(circle at 85% 20%, #174a91 0%, transparent 35%),
        linear-gradient(135deg, #03142b 0%, #082d5f 55%, #0a4388 100%);

    color: white;
}

#home p:first-child {
    color: #73a9ff;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 4px;
    margin-bottom: 25px;
}

#home h1 {
    max-width: 900px;
    font-size: 64px;
    line-height: 1.05;
    letter-spacing: -2px;
    margin-bottom: 28px;
    color: #ffffff;
}

#home p {
    max-width: 680px;
    font-size: 19px;
    margin-bottom: 35px;
    color: #dce9ff;
}

#home a {
    display: inline-block;
    width: fit-content;
    padding: 15px 30px;
    background: #ffffff;
    color: #082d5f;
    text-decoration: none;
    font-weight: 800;
    border-radius: 8px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
    transition: 0.2s ease;
}

#home a:hover {
    transform: translateY(-4px);
    background: #73a9ff;
    color: #061a35;
}

/* =========================
   ABOUT
========================= */

#about {
    background: #ffffff;
    border-left: 5px solid #0b4ea2;
    border-radius: 0 16px 16px 0;
    margin-top: 50px;
    margin-bottom: 50px;
    box-shadow: 0 10px 35px rgba(6, 26, 53, 0.08);
}

#about p {
    max-width: 780px;
    margin-bottom: 18px;
    font-size: 17px;
}

/* =========================
   SEO & META ADS
========================= */

#seo,
#ads {
    background: #f4f7fb;
}

#seo > p,
#ads > p {
    max-width: 750px;
    font-size: 17px;
    margin-bottom: 30px;
}

/* =========================
   SKILL CARDS
========================= */

#seo div,
#ads div {
    background: #ffffff;
    padding: 32px;
    border-top: 4px solid #0b4ea2;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(6, 26, 53, 0.08);
}

#seo li::marker,
#ads li::marker {
    color: #0b4ea2;
}

ul {
    padding-left: 22px;
}

li {
    margin-bottom: 9px;
    color: #405570;
}

/* =========================
   PROJECTS
========================= */

#projects {
    background: #ffffff;
    border-radius: 20px;
    margin-top: 50px;
    margin-bottom: 50px;
}

article {
    background: #f4f7fb;
    padding: 32px;
    margin-top: 22px;
    border: 1px solid #d7e2f0;
    border-left: 5px solid #0b4ea2;
    border-radius: 10px;
    transition: 0.25s ease;
}

article:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(6, 26, 53, 0.12);
}

article h3 {
    color: #082d5f;
}

article p {
    margin-bottom: 10px;
}

/* =========================
   CONTACT
========================= */

#contact {
    text-align: center;
    background: linear-gradient(135deg, #061a35, #0b4ea2);
    border-radius: 20px;
    margin-top: 50px;
    margin-bottom: 50px;
}

#contact h2 {
    color: #ffffff;
}

#contact p {
    color: #dce9ff;
    margin-bottom: 10px;
}

/* =========================
   FOOTER
========================= */

footer {
    text-align: center;
    padding: 35px 20px;
    background: #03142b;
    color: #ffffff;
}

footer p {
    color: #b9cbea;
}

/* =========================
   MOBILE RESPONSIVE DESIGN
========================= */

@media (max-width: 768px) {

    nav {
        flex-direction: column;
        gap: 15px;
        padding: 16px 15px;
    }

    nav div {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
    }

    nav a {
        font-size: 13px;
        padding: 4px;
    }

    #home {
        min-height: 85vh;
        padding: 90px 22px;
    }

    #home h1 {
        font-size: 42px;
        letter-spacing: -1px;
    }

    #home p {
        font-size: 17px;
    }

    section {
        padding: 70px 22px;
    }

    section h2 {
        font-size: 32px;
    }

    #seo div,
    #ads div,
    article {
        padding: 23px;
    }
}

/* =========================
   SMALL PHONES
========================= */

@media (max-width: 400px) {

    #home h1 {
        font-size: 36px;
    }

    #home p:first-child {
        font-size: 12px;
        letter-spacing: 2px;
    }

    nav a {
        font-size: 12px;
    }
}
