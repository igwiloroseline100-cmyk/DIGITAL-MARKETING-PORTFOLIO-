{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    background: #f7f8fc;
    color: #172033;
}

/* Navigation */

header {
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    position: sticky;
    top: 0;
    z-index: 1000;
}

nav {
    max-width: 1100px;
    margin: auto;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

nav h2 {
    font-size: 24px;
}

nav a {
    color: #172033;
    text-decoration: none;
    margin-left: 18px;
    font-size: 14px;
}

nav a:hover {
    text-decoration: underline;
}

/* General sections */

section {
    max-width: 1100px;
    margin: auto;
    padding: 90px 20px;
}

/* Hero */

#home {
    min-height: 92vh;
    max-width: 1200px;
    margin: auto;
    padding: 100px 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: linear-gradient(135deg, #eef2ff, #ffffff);
    border-radius: 0 0 30px 30px;
}

#home p:first-child {
    color: #4f46e5;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 3px;
    margin-bottom: 24px;
}

#home h1 {
    max-width: 850px;
    font-size: 60px;
    line-height: 1.05;
    letter-spacing: -2px;
    margin-bottom: 28px;
}

#home p {
    max-width: 680px;
    font-size: 19px;
    color: #596174;
    margin-bottom: 35px;
}

#home a {
    display: inline-block;
    width: fit-content;
    padding: 15px 28px;
    background: #4f46e5;
    color: white;
    text-decoration: none;
    font-weight: 700;
    border-radius: 10px;
    transition: transform 0.2s ease;
}

#home a:hover {
    transform: translateY(-3px);
}
/* Headings */

section h2 {
    font-size: 36px;
    margin-bottom: 20px;
}

section h3 {
    font-size: 22px;
    margin: 25px 0 15px;
}

/* Lists */

ul {
    padding-left: 20px;
}

li {
    margin-bottom: 8px;
}

/* Projects */

article {
    background: white;
    padding: 30px;
    margin-top: 20px;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
}

article p {
    margin-bottom: 10px;
}

/* Contact */

#contact {
    text-align: center;
}

/* Footer */

footer {
    text-align: center;
    padding: 30px 20px;
    background: #172033;
    color: white;
}

/* Mobile */

@media (max-width: 768px) {

    nav {
        flex-direction: column;
        gap: 15px;
    }

    nav div {
        text-align: center;
    }

    nav a {
        display: inline-block;
        margin: 5px;
    }

    #home h1 {
        font-size: 38px;
    }

    section {
        padding: 65px 20px;
    }

    section h2 {
        font-size: 30px;
    }
}
