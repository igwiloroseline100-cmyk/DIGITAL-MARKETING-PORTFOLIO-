/* ---------- RESET ---------- */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
    background: #f8fafc;
    color: #172033;
}

/* ---------- NAVIGATION ---------- */

header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.95);
    border-bottom: 1px solid #e2e8f0;
    backdrop-filter: blur(10px);
}

nav {
    max-width: 1150px;
    margin: auto;
    padding: 18px 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

nav h2 {
    font-size: 24px;
    color: #4f46e5;
}

nav div {
    display: flex;
    align-items: center;
    gap: 20px;
}

nav a {
    color: #334155;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: 0.2s ease;
}

nav a:hover {
    color: #4f46e5;
}

/* ---------- GENERAL SECTIONS ---------- */

section {
    max-width: 1150px;
    margin: auto;
    padding: 100px 25px;
}

section h2 {
    font-size: 38px;
    line-height: 1.2;
    margin-bottom: 20px;
}

section h3 {
    font-size: 22px;
    margin-bottom: 15px;
}

section p {
    color: #64748b;
}

/* ---------- HERO ---------- */

#home {
    max-width: none;
    min-height: 90vh;
    padding: 120px max(25px, calc((100% - 1100px) / 2));
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: linear-gradient(135deg, #eef2ff 0%, #ffffff 55%, #e0e7ff 100%);
}

#home p:first-child {
    color: #4f46e5;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 3px;
    margin-bottom: 25px;
}

#home h1 {
    max-width: 900px;
    font-size: 64px;
    line-height: 1.05;
    letter-spacing: -2px;
    margin-bottom: 25px;
}

#home p {
    max-width: 680px;
    font-size: 19px;
    margin-bottom: 35px;
}

#home a {
    display: inline-block;
    width: fit-content;
    padding: 15px 28px;
    background: #4f46e5;
    color: white;
    text-decoration: none;
    font-weight: 700;
    border-radius: 10px;
    box-shadow: 0 10px 25px rgba(79, 70, 229, 0.25);
    transition: 0.2s ease;
}

